# 複製為 .env 後再依環境覆寫。docker compose 會自動讀取根目錄 .env。
# 本檔為介面契約：變數名稱一經鎖定，後續 Phase 不再更名。

# ---------- ROS 2 DDS（publisher 與 backend 必須相同）----------
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ---------- GNSS Publisher ----------
# 容器內路徑（compose 掛載 ./data:/data:ro）。本機直接 ros2 launch 時改為
# 例如 ./data/path_data.csv 或絕對路徑。
GPS_CSV_PATH=/data/path_data.csv
PUBLISH_RATE_HZ=5

# ---------- 對外埠口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---------- Frontend WebSocket ----------
# 本機 Vite dev（:5173）連本機 backend。Production 由 nginx 反代 /ws，
# 建置時改為相對路徑（例如 ws://localhost:8080/ws/gps）或同源位址。
VITE_WS_URL=ws://localhost:8000/ws/gps
